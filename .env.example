# ==============================================================================
# ONCEClic SaaS Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` in the project root to configure your environment.
# NEVER commit your real `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION [REQUIRED] (SERVER-ONLY)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development                       # 'development' or 'production'
APP_URL=http://localhost:3000              # Public Frontend Web App URL (e.g. https://onceclic.com)
FRONTEND_URL=http://localhost:3000         # Public Frontend Origin (e.g. https://onceclic.com)
API_URL=http://localhost:5000              # Public Backend API Server URL (e.g. https://api.onceclic.com)
CORS_ORIGIN=http://localhost:3000          # Allowed CORS origins (e.g. https://onceclic.com,https://www.onceclic.com)

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY [REQUIRED] (SERVER-ONLY - NEVER EXPOSE)
# ------------------------------------------------------------------------------
# In production, generate a secure random 64-char key (e.g. `openssl rand -hex 32`)
AUTH_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# ------------------------------------------------------------------------------
# 3. SUPABASE / POSTGRESQL DATABASE [REQUIRED IN PRODUCTION] (SERVER-ONLY)
# ------------------------------------------------------------------------------
# In production, provide your Supabase connection string:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.yourprojectref:yourdbpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 4. RESEND TRANSACTIONAL EMAIL [REQUIRED FOR EMAIL VERIFICATION & BOOKINGS] (SERVER-ONLY)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=ONCEClic <notifications@onceclic.com>

# ------------------------------------------------------------------------------
# 5. COMPOSIO MANAGED OAUTH (GMAIL & GOOGLE CALENDAR - NO GOOGLE CLOUD BILLING REQUIRED)
# ------------------------------------------------------------------------------
# Get your API key from https://platform.composio.dev/
# Provides managed OAuth and tools for Gmail and Google Calendar without payment card verification
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_WEBHOOK_SECRET=your_composio_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 5A. INSTAGRAM & FACEBOOK WEBHOOK VERIFICATION (META APP DASHBOARD)
# ------------------------------------------------------------------------------
# Secret token configured in Meta App Dashboard -> Webhooks -> Verify Token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_instagram_webhook_verify_token_here

# ------------------------------------------------------------------------------
# 5B. OPTIONAL DIRECT GOOGLE OAUTH (FALLBACK)
# ------------------------------------------------------------------------------
# Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Authentication callback:
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Google Calendar integration callback:
GOOGLE_CALENDAR_CALLBACK_URL=http://localhost:5000/api/integrations/google-calendar/callback
GOOGLE_EMAIL_CALLBACK_URL=http://localhost:5000/api/integrations/google-email/callback

# ------------------------------------------------------------------------------
# 6. AI PROVIDER CONFIGURATION (GEMINI & OPENAI) [SERVER-ONLY - NEVER EXPOSE]
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini                          # 'gemini' (default) or 'openai'
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=text-embedding-004

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 7. PADDLE BILLING V2 [REQUIRED FOR LIVE BILLING]
# ------------------------------------------------------------------------------
# SERVER-ONLY variables (NEVER expose to client):
PADDLE_ENVIRONMENT=sandbox                 # 'sandbox' or 'production'
PADDLE_API_KEY=pdl_apikey_your_secret_server_api_key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_key_from_paddle_dashboard

# Plan-specific Price IDs (create one recurring price per plan in Paddle dashboard):
PADDLE_STARTER_PRICE_ID=pri_your_starter_price_id    # $19/mo USD recurring — Starter plan (50 voice min)
PADDLE_PRO_PRICE_ID=pri_your_pro_price_id            # $49/mo USD recurring — Pro plan (150 voice min)
PADDLE_BUSINESS_PRICE_ID=pri_your_business_price_id  # $99/mo USD recurring — Business plan (400 voice min)

# CLIENT-SAFE variables (Can be used in frontend checkout overlay):
VITE_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token_here
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_STARTER_PRICE_ID=pri_your_starter_price_id    # $19/mo — Starter
VITE_PADDLE_PRO_PRICE_ID=pri_your_pro_price_id            # $49/mo — Pro
VITE_PADDLE_BUSINESS_PRICE_ID=pri_your_business_price_id  # $99/mo — Business
VITE_API_URL=https://api.onceclic.com

# ------------------------------------------------------------------------------
# 8. VOICE RECEPTIONIST — TELNYX (TELEPHONY) [REQUIRED FOR VOICE]
# ------------------------------------------------------------------------------
# SERVER-ONLY — Never expose to frontend or VITE_ prefix
# Obtain from Telnyx Portal: https://portal.telnyx.com/
TELNYX_API_KEY=KEY01234567890your_telnyx_api_key_here
# Created in Telnyx: Voice > SIP Trunking > Connections
TELNYX_CONNECTION_ID=your_telnyx_connection_id_here
# Ed25519 public key from Telnyx Portal > API Keys > Signing Keys (used for webhook verification)
TELNYX_PUBLIC_KEY=your_telnyx_ed25519_public_key_here
# Only required if ONCEClic uses Telnyx for SMS/messaging (optional for voice-only)
# TELNYX_MESSAGING_PROFILE_ID=your_messaging_profile_id_here

# ------------------------------------------------------------------------------
# 9. VOICE RECEPTIONIST — VAPI (VOICE AI ORCHESTRATION) [REQUIRED FOR VOICE]
# ------------------------------------------------------------------------------
# SERVER-ONLY — Never expose to frontend or VITE_ prefix
# Obtain from Vapi Dashboard: https://dashboard.vapi.ai/
VAPI_API_KEY=your_vapi_api_key_here
# Optional: pre-created assistant ID (only if NOT using dynamic per-call assistant)
# VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
# HMAC secret for verifying Vapi webhook signatures
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret_here
# Gemini model used inside Vapi for voice LLM (Vapi provider: 'google')
# Supported: gemini-3.5-flash, gemini-2.5-flash, gemini-2.5-pro, gemini-2.5-flash-lite
VAPI_GEMINI_MODEL=gemini-3.5-flash

# Voice provider: 'vapi' (production) or 'mock' (test/default)
VOICE_PROVIDER=mock

# ------------------------------------------------------------------------------
# 10. OPTIONAL / ADVANCED
# ------------------------------------------------------------------------------
DEBUG_SQL=false                            # Set to 'true' to log SQL queries and timings
