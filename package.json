{
  "name": "onceclic",
  "version": "1.0.0",
  "private": true,
  "description": "ONCEClic - AI Receptionist for Small Businesses (Website, Email, Appointments)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build:shared": "npm --workspace=shared run build",
    "build:server": "npm --workspace=server run build",
    "build:client": "npm --workspace=client run build",
    "build": "npm run build:shared && npm run build:server && npm run build:client",
    "test": "npx tsx tests/run-all.ts",
    "composio:verify": "npx tsx server/src/scripts/verify-composio.ts",
    "composio:setup": "npx tsx server/src/scripts/setup-composio.ts",
    "start": "node server/dist/index.js",
    "migrate": "node server/dist/db/migrate.js"
  },
  "keywords": [
    "ai-receptionist",
    "saas",
    "b2b",
    "appointment-booking",
    "paddle-billing",
    "multi-tenant"
  ],
  "author": "ONCEClic",
  "license": "UNLICENSED",
  "dependencies": {
    "typescript": "^5.4.5",
    "tsx": "^4.16.2"
  },
  "devDependencies": {
    "@paddle/paddle-node-sdk": "^3.10.0"
  }
}
