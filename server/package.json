{
  "name": "@onceclic/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'src','db','migrations'),dst=path.join(__dirname,'dist','db','migrations');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});for(const f of fs.readdirSync(src)){fs.copyFileSync(path.join(src,f),path.join(dst,f));}}\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "node --loader ts-node/esm ../tests/run-all.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@onceclic/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.52.0",
    "pg": "^8.12.0",
    "uuid": "^10.0.0",
    "@paddle/paddle-node-sdk": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5"
  }
}
